# Cadena de conexión a Supabase (PostgreSQL). NO incluyas comillas.
#
# IMPORTANTE: en entornos sin IPv6 (GitHub Codespaces / devcontainers) usa la
# cadena del "Connection Pooler" (gratuita, IPv4), NO la conexión directa.
#
# Pooler (recomendado, IPv4):
#   postgresql://postgres.<PROJECT_REF>:PASSWORD@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Directa (solo IPv6, falla con ENETUNREACH en Codespaces):
#   postgresql://postgres:PASSWORD@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS / Frontend
FRONTEND_URL=http://localhost:5173

# Servidor
PORT=3001
NODE_ENV=development
